<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.istanbulairportcam"
       name="Istanbul Airport Live Cam"
       version="1.0.0"
       provider-name="Haris">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>

  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary>Istanbul Airport live camera (auto-refresh token)</summary>
    <description>Fetches the current HLS URL from the player page every time you press Play, so expiring tokens are handled automatically.</description>
    <platform>all</platform>
  </extension>
</addon>
